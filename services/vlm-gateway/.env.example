# 网关令牌与供应商密钥必须分别配置；不要提交真实值。
VLM_GATEWAY_TOKEN=replace-with-your-development-token
QWEN_API_KEY=
QWEN_MODEL=qwen3-vl-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SEED_API_KEY=
SEED_MODEL=doubao-seed-2-0-lite-260215
SEED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
GPT_API_KEY=
# 填写账号可用、支持图像和结构化输出的 GPT 模型 ID。
GPT_MODEL=
GPT_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
# 填写账号可用、支持图像和结构化输出的 Gemini 模型 ID。
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# P4 多图默认关闭。完成该实际模型的多图实测后，填写与 *_MODEL 完全一致的 ID，并设置 1..8。
# 更换模型时必须重新验收；未声明或 ID 不一致时 App 转入手动选景。
QWEN_MULTI_IMAGE_MODEL=
QWEN_MULTI_IMAGE_MAX_IMAGES=0
SEED_MULTI_IMAGE_MODEL=
SEED_MULTI_IMAGE_MAX_IMAGES=0
GPT_MULTI_IMAGE_MODEL=
GPT_MULTI_IMAGE_MAX_IMAGES=0
GEMINI_MULTI_IMAGE_MODEL=
GEMINI_MULTI_IMAGE_MAX_IMAGES=0
