+// Framer Sense: use the upstream callback stop path, never throw inside a backend execution.
+bool Llm::checkCancelled() {
+    if (mContext->status == LlmStatus::USER_CANCEL) return true;
+    if (mCancelCallback && mCancelCallback()) {
+        mContext->status = LlmStatus::USER_CANCEL;
+        return true;
+    }
+    return false;
+}
+
+void Llm::setCancelCallback(std::function<bool()> callback) {
+    mCancelCallback = std::move(callback);
+    if (!mCancelCallbacksInstalled) {
+        // Install before load: StaticModule snapshots Session_Debug when the graph is created.
+        setDebugCallback(
+            [this](const std::vector<Tensor*>&, const OperatorInfo*) {
+                if (!mCancelGraphActive) return true;
+                ++mCancelOperatorChecks;
+                return !checkCancelled();
+            },
+            [this](const std::vector<Tensor*>&, const OperatorInfo*) {
+                if (!mCancelGraphActive) return true;
+                ++mCancelOperatorChecks;
+                return !checkCancelled();
+            });
+        mCancelCallbacksInstalled = true;
+    }
+}
+
+std::vector<Express::VARP> Llm::forwardCancelable(Express::Module* module, const std::vector<Express::VARP>& inputs) {
+    if (checkCancelled()) return {};
+    // Complete input preprocessing outside the abortable graph. CV/Express callers may not
+    // handle null readMap results; they must not be interrupted by the operator callback.
+    for (const auto& input : inputs) {
+        if (checkCancelled()) return {};
+        if (input.get() == nullptr || !input->readMap<void>()) {
+            if (mContext->status != LlmStatus::USER_CANCEL) mContext->status = LlmStatus::INTERNAL_ERROR;
+            return {};
+        }
+    }
+    if (checkCancelled()) return {};
+    struct GraphScope {
+        bool& active;
+        bool previous;
+        GraphScope(bool& flag) : active(flag), previous(flag) { active = true; }
+        ~GraphScope() { active = previous; }
+    } scope(mCancelGraphActive);
+    auto outputs = module->onForward(inputs);
+    if (checkCancelled()) return {};
+    if (outputs.empty()) {
+        if (mContext->status != LlmStatus::USER_CANCEL) mContext->status = LlmStatus::INTERNAL_ERROR;
+        return {};
+    }
+    for (const auto& output : outputs) {
+        if (output.get() == nullptr || !output->getInfo() || !output->readMap<void>()) {
+            if (!checkCancelled()) mContext->status = LlmStatus::INTERNAL_ERROR;
+            return {};
+        }
+        if (checkCancelled()) return {};
+    }
+    return outputs;
+}
+
+void Llm::resetCancelledRequest() {
+    Express::ExecutorScope scope(mExecutor);
+    reset();
+    // previous == remove makes every CPU attention layer reallocate its KV cache on the
+    // next prefill, including layers that wrote partial KV before CALL_BACK_STOP.
+    setKVCacheInfo(0, getCurrentHistory());
+    generate_init(nullptr, "");
+    mGenerateParam->outputs.clear();
+    mGenerateParam->input_embeds = nullptr;
+    mGenerateParam->validLogitSize = 0;
+    mGenerateParam->validLogitStart = 0;
+    inputsEmbeds = nullptr;
+    mPleInput = nullptr;
+    mTextEmbedsForPle = nullptr;
+}
